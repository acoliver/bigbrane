{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbrane.local/schemas/difference.schema.json",
  "title": "Difference statement (DISCOVERY-PIPELINE-PLAN.md sections 3.1 and 8, Phase 7). Written by the proposer at S2, checked on the host and by the prior-art role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["closest_prior", "what_was_tried", "why_it_failed", "precise_change", "changed_equation",
               "cause_ids_addressed"],
  "properties": {
    "closest_prior": {
      "description": "Closest prior works: literature (a source id from this card's prior-art search), outcome (a record id of the outcome store, from this card's own-history matches) or family (an id of hybrid/config/families.toml).",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "title", "what_was_tried", "why_it_failed"],
        "properties": {
          "kind": {"enum": ["literature", "outcome", "family"]},
          "ref": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "what_was_tried": {"type": "string", "minLength": 1},
          "why_it_failed": {"type": "string", "minLength": 1}
        }
      }
    },
    "what_was_tried": {"type": "string", "minLength": 1},
    "why_it_failed": {"type": "string", "minLength": 1, "description": "A quote from the prior work, or the outcome cause id."},
    "precise_change": {"type": "string", "minLength": 1, "maxLength": 600, "description": "One sentence."},
    "changed_equation": {"type": "string", "pattern": "^((update|readout)\\[[0-9]+\\]|learning)$"},
    "evidence_scope": {
      "description": "Host-scoped accepted content; original prose remains in the difference artifact.",
      "type": "object", "additionalProperties": false,
      "required": ["status", "excerpt_gaps", "source_calls"],
      "properties": {
        "status": {"const": "excerpt_limited"},
        "excerpt_gaps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_calls": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cause_ids_addressed": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

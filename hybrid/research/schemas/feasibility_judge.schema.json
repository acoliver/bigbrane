{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbrane.local/schemas/feasibility_judge.schema.json",
  "title": "Feasibility judge output (S3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "obligations", "fatal_issues", "confidence"],
  "properties": {
    "verdict": {"enum": ["feasible", "infeasible", "undetermined"]},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "argument"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["discharged", "open", "refuted"]},
          "argument": {"type": "string", "minLength": 1}
        }
      }
    },
    "fatal_issues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "if": {"properties": {"verdict": {"const": "feasible"}}},
  "then": {"properties": {"fatal_issues": {"maxItems": 0}}}
}

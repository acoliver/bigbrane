{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbrane.local/schemas/reduction_critic.schema.json",
  "title": "Reduction critic output (S2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["reduces_to", "mapping", "confidence", "difference_if_any", "known_work", "known_work_sources",
               "fixed_learned_parts", "surprise", "why", "textbook_transplant", "textbook_why"],
  "properties": {
    "reduces_to": {
      "enum": [
        "none", "rnn", "lstm_gru", "linear_attention", "ssm", "hopfield_or_kernel_memory",
        "transformer_variant", "moe", "bitnet_or_quantized", "partitioned_or_windowed_attention",
        "lcm_concept_model", "other_known"
      ]
    },
    "mapping": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "difference_if_any": {"type": "string"},
    "known_work": {
      "type": "boolean",
      "description": "True when the card's general mechanism (update, readout and learning rule with learned parameters free) is already published or textbook. Gated only with evidence: a host-counted comparator or an accepted cited source (stages/known_work.py)."
    },
    "known_work_sources": {
      "description": "The closest published or textbook forms, each with the steps of the card it accounts for. Required when known_work is true; may also be given when it is false.",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "covers"],
        "properties": {
          "kind": {"enum": ["paper", "textbook", "standard_algorithm"]},
          "ref": {"type": "string", "minLength": 1, "description": "paper: an id from the search results; textbook: author, title and section; standard_algorithm: its name."},
          "covers": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixed_learned_parts": {
      "description": "Learned or tunable parts the mapping fixes, zeroes or sets to the hand witness, each only when the card states a capability the frozen form lacks. Empty when the mapping holds with every learned part free.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "capability"],
        "properties": {"part": {"type": "string", "minLength": 1}, "capability": {"type": "string", "minLength": 1}}
      }
    },
    "surprise": {
      "type": "boolean",
      "description": "Whether the core would surprise a researcher who knows the out-of-scope families. Recorded, not gated."
    },
    "why": {"type": "string", "minLength": 1},
    "textbook_transplant": {
      "type": "boolean",
      "description": "True when the core idea is a textbook construction from its source field applied without modification. Recorded, not gated."
    },
    "textbook_why": {"type": "string", "minLength": 1},
    "comparators": {
      "description": "FIX-12: the known forms the numeric check compares with the card, declared before the check is written. The check reports each one under its id; the host decides from the transformation types whether a comparison counts for the base family.",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "base_family", "base_form", "update", "read", "transformations", "parameter_mapping",
                     "limit_only"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
          "base_family": {
            "enum": [
              "rnn", "lstm_gru", "linear_attention", "ssm", "hopfield_or_kernel_memory", "transformer_variant",
              "moe", "bitnet_or_quantized", "partitioned_or_windowed_attention", "lcm_concept_model", "other_known"
            ]
          },
          "base_form": {"type": "string", "minLength": 1},
          "update": {"type": "string", "minLength": 1},
          "read": {"type": "string", "minLength": 1},
          "transformations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "what"],
              "properties": {
                "type": {
                  "enum": ["normalizer", "gate", "feature_map", "change_of_basis", "lifted_state", "sparsity",
                           "transformed_input", "multi_read", "other"]
                },
                "what": {"type": "string", "minLength": 1}
              }
            }
          },
          "parameter_mapping": {"type": "string", "minLength": 1},
          "limit_only": {"type": "boolean"},
          "components": {
            "description": "KD8: the comparator's own parts, each a published component or the card's. Required in practice for families rnn, lstm_gru and other_known (the host does not count a comparator without them).",
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "name", "origin", "cite"],
              "properties": {
                "role": {"enum": ["activation", "transition", "update", "readout", "input_map"]},
                "name": {"type": "string", "minLength": 1},
                "origin": {"enum": ["published", "card"]},
                "cite": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"reduces_to": {"const": "none"}}},
     "then": {"properties": {"mapping": {"type": ["string", "null"]}, "comparators": {"maxItems": 0}}},
     "else": {"required": ["comparators"],
              "properties": {"mapping": {"type": "string", "minLength": 1}, "comparators": {"minItems": 1}}}},
    {"if": {"properties": {"known_work": {"const": true}}},
     "then": {"properties": {"known_work_sources": {"minItems": 1}}}}
  ]
}

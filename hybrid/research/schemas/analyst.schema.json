{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbrane.local/schemas/analyst.schema.json",
  "title": "Analyst claims ledger (S6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "status",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "refuted",
              "untested"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "falsifier_tasks": {
            "description": "Ids of the falsifier tasks whose numbers this entry uses; empty when it uses only the standard bench tasks or no numbers.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

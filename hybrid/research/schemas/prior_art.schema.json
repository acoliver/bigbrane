{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbrane.local/schemas/prior_art.schema.json",
  "title": "Prior art classification (S2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "evidence", "notes"],
  "properties": {
    "label": {"enum": ["novel", "novelty_unassessed", "prior_art_tested", "prior_art_undertested", "known_disproven"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "url", "relation"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "string"}
  },
  "if": {"properties": {"label": {"enum": ["novel", "novelty_unassessed"]}}},
  "then": {},
  "else": {"properties": {"evidence": {"minItems": 1}}}
}
